{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": ["tsconfig.base.json"],
	"globalPassThroughEnv": ["NEXT_TELEMETRY_DISABLED"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"dependsOn": ["build"],
			"persistent": true
		}
	},
	"ui": "tui"
}
