{
	"name": "ptas-website",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev": "turbo run dev",
		"lint": "biome check --write .",
		"start": "turbo run start"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"lefthook": "^2.1.16",
		"turbo": "^2.11.7"
	},
	"packageManager": "bun@1.4.2",
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.2",
			"onFail": "warn"
		}
	}
}
